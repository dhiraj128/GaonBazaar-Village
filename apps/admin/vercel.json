{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "has": [{ "type": "host", "value": "dukaan.apnagaonbazaar.in" }],
      "source": "/(.*)",
      "destination": "/vendor/index.html"
    },
    {
      "has": [{ "type": "host", "value": "mitra.apnagaonbazaar.in" }],
      "source": "/(.*)",
      "destination": "/runner/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
