{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=(), geolocation=(self), payment=(self \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://*.razorpay.com https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://gaonbazaar-village.onrender.com https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com https://*.razorpay.com https://ifsc.razorpay.com https://maps.googleapis.com https://*.googleapis.com https://nominatim.openstreetmap.org https://api.qrserver.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.razorpay.com https://checkout.razorpay.com;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "has": [{ "type": "host", "value": "dukaan.apnagaonbazaar.in" }],
      "source": "/vendor_script_:file(.*)",
      "destination": "/vendor/vendor_script_$file"
    },
    {
      "has": [{ "type": "host", "value": "dukaan.apnagaonbazaar.in" }],
      "source": "/vendor/(.*)",
      "destination": "/vendor/$1"
    },
    {
      "has": [{ "type": "host", "value": "dukaan.apnagaonbazaar.in" }],
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf|webmanifest))",
      "destination": "/vendor/$1"
    },
    {
      "has": [{ "type": "host", "value": "dukaan.apnagaonbazaar.in" }],
      "source": "/(.*)",
      "destination": "/vendor/index.html"
    },
    {
      "has": [{ "type": "host", "value": "mitra.apnagaonbazaar.in" }],
      "source": "/runner_script_:file(.*)",
      "destination": "/runner/runner_script_$file"
    },
    {
      "has": [{ "type": "host", "value": "mitra.apnagaonbazaar.in" }],
      "source": "/runner/(.*)",
      "destination": "/runner/$1"
    },
    {
      "has": [{ "type": "host", "value": "mitra.apnagaonbazaar.in" }],
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf|webmanifest))",
      "destination": "/runner/$1"
    },
    {
      "has": [{ "type": "host", "value": "mitra.apnagaonbazaar.in" }],
      "source": "/(.*)",
      "destination": "/runner/index.html"
    },
    {
      "has": [{ "type": "host", "value": "admin.apnagaonbazaar.in" }],
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/customer_script_:file(.*)",
      "destination": "/customer/customer_script_$file"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
